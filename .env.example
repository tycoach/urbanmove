# ══════════════════════════════════════════════════════════════
# UrbanMove Analytics — Environment Variables

#  Copy this file:   cp .env.example .env



# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres          
POSTGRES_PORT=5432
POSTGRES_DB=urbanmove_db
POSTGRES_USER=urbanmove
POSTGRES_PASSWORD=urbanmove_pass

# ── Airflow ───────────────────────────────────────────────────
# Generate Fernet key and Secret Key
# python -c "
# from cryptography.fernet import Fernet
# import secrets
# print('AIRFLOW_FERNET_KEY=' + Fernet.generate_key().decode())
# print('AIRFLOW_SECRET_KEY=' + secrets.token_hex(32))
# "
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=

# Airflow admin user (created by airflow-init on first boot)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ── Pipeline ──────────────────────────────────────────────────
ENVIRONMENT=development         # development | production
